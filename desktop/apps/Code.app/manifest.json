{
  "id": "org.tiny.code",
  "name": "Code",
  "version": "1.0.0",
  "kind": "app",
  "icon": "Resources/icon.svg",
  "ui": "Resources/ui/index.html",
  "window": {
    "width": 1160,
    "height": 720,
    "minWidth": 680,
    "minHeight": 420
  },
  "permissions": [
    "fs.user",
    "clipboard",
    "network"
  ],
  "minify": true,
  "typeDefinitions": [
    {
      "uti": "org.tiny.vsix",
      "conformsTo": [
        "public.archive"
      ],
      "mime": "application/vsix",
      "description": "VS Code extension package",
      "ext": [
        "vsix"
      ]
    }
  ],
  "documentTypes": [
    {
      "ext": [
        "vsix"
      ],
      "role": "viewer",
      "uti": "org.tiny.vsix",
      "icon": "Resources/icon.svg"
    }
  ]
}
