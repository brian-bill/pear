{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@tiny/sdk": [
        "./sdk/client.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "sdk",
    "apps",
    "server",
    "../api",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}